{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ZacWalk/dd/main/schema/dd.schema.json",
  "title": "dd PowerShell data file model schema 1",
  "type": "object",
  "required": ["schema", "project", "build", "targets"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "dependencies": { "type": "object", "required": ["owner"], "additionalProperties": false, "properties": { "owner": { "enum": ["dd", "application"] } } },
    "requirements": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "tools": { "type": "object", "propertyNames": { "enum": ["cmake", "ctest", "ninja", "git", "gcc", "python", "gdb"] }, "additionalProperties": {
          "type": "object", "additionalProperties": false, "properties": {
            "minimum": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+){0,2}$" }, "optional": { "type": "boolean" }, "platforms": { "$ref": "#/$defs/platforms" }
          }
        } },
        "msvc": { "type": "object", "additionalProperties": false, "properties": {
          "minimum": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+){0,2}$" }, "components": { "type": "array", "items": { "type": "string", "pattern": "^Microsoft\\.VisualStudio\\.[A-Za-z0-9_.]+$" } }
        } }
      }
    },
    "project": {
      "type": "object", "required": ["name", "type"], "additionalProperties": false,
      "properties": { "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" }, "type": { "enum": ["gui", "cli"] }, "default-target": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" } }
    },
    "build": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "properties": { "x64-windows": { "$ref": "#/$defs/presets" }, "x64-linux": { "$ref": "#/$defs/presets" } }
    },
    "targets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "kind", "cmake-target", "debug-path", "release-path"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
          "kind": { "enum": ["gui", "cli"] },
          "cmake-target": { "type": "string", "minLength": 1 },
          "debug-path": { "type": "string", "minLength": 1 },
          "release-path": { "type": "string", "minLength": 1 },
          "test-label": { "type": "string", "minLength": 1 },
          "platforms": { "$ref": "#/$defs/platforms" }
        }
      }
    },
    "commands": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$",
        "not": { "enum": ["help", "init", "toolchain", "doctor", "dep", "build", "test", "run", "launch", "clean", "ide", "fmt", "env", "self-update", "adopt", "mcp", "commands", "targets"] }
      },
      "additionalProperties": {
        "type": "object", "required": ["description", "script", "effects"], "additionalProperties": false,
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "script": { "type": "string", "pattern": "\\.ps1$" },
          "effects": { "enum": ["read", "write"] },
          "supports-dry-run": { "type": "boolean", "default": false },
          "timeout-secs": { "type": "integer", "minimum": 1, "maximum": 9999, "default": 60 },
          "platforms": { "$ref": "#/$defs/platforms" },
          "parameters": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9-]*$",
              "not": { "enum": ["project", "json", "non-interactive", "dry-run", "yes", "available", "verbose", "no-summary", "register", "vscode", "words", "forwarded"] }
            },
            "additionalProperties": { "$ref": "#/$defs/parameter" }
          }
        }
      }
    }
  },
  "$defs": {
    "presets": { "type": "object", "required": ["debug", "release"], "additionalProperties": false, "properties": { "debug": { "$ref": "#/$defs/phases" }, "release": { "$ref": "#/$defs/phases" }, "ide": { "type": "string", "minLength": 1 } } },
    "phases": { "oneOf": [
      { "type": "string", "minLength": 1 },
      { "type": "object", "required": ["configure", "build", "test"], "additionalProperties": false, "properties": {
        "configure": { "type": "string", "minLength": 1 }, "build": { "type": "string", "minLength": 1 }, "test": { "type": "string", "minLength": 1 }
      } }
    ] },
    "platforms": { "type": "array", "minItems": 1, "items": { "enum": ["x64-windows", "x64-linux"] } },
    "parameter": {
      "type": "object", "required": ["type"], "additionalProperties": false,
      "properties": {
        "type": { "enum": ["string", "integer", "boolean"] },
        "description": { "type": "string" }, "required": { "type": "boolean", "default": false },
        "default": { "type": ["string", "integer", "boolean"] },
        "choices": { "type": "array", "minItems": 1, "items": { "type": ["string", "integer", "boolean"] } }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "string" } } }, "then": { "properties": { "default": { "type": "string" }, "choices": { "items": { "type": "string" } } } } },
        { "if": { "properties": { "type": { "const": "integer" } } }, "then": { "properties": { "default": { "type": "integer" }, "choices": { "items": { "type": "integer" } } } } },
        { "if": { "properties": { "type": { "const": "boolean" } } }, "then": { "properties": { "default": { "type": "boolean" }, "choices": { "items": { "type": "boolean" } } } } }
      ]
    }
  }
}